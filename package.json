{
  "name": "cv-graphql",
  "version": "1.0.0",
  "description": "Цифровая визитка разработчика: NestJS + GraphQL + Prisma + PostgreSQL",
  "private": true,
  "license": "MIT",
  "author": "Сергей Сегренёв",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/seed/main.js",
    "db:setup": "prisma migrate deploy && node dist/seed/main.js",
    "start:prod": "prisma migrate deploy && node dist/seed/main.js && node dist/main.js",
    "lint:types": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand"
  },
  "prisma": {
    "seed": "ts-node --transpile-only src/seed/main.ts"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "11.2.8",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/client": "6.19.3",
    "dataloader": "2.2.3",
    "graphql": "16.14.2",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "jest": "29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=20"
  }
}
